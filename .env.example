# Required: your getbro.ws API key (https://getbro.ws).
BRO_API_KEY=sk_your_key_here

# Optional: an Instagram `sessionid` cookie value.
# Anonymous runs can read profiles and their posts; a session unlocks
# comments, hashtags, places, search and stories through the private API.
IG_SESSIONID=

# Optional: where the dataset is written (default: ./storage)
# OUTPUT_DIR=storage

APIFY_API_KEY=
